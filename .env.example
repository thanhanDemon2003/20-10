# Sao chép file này thành .env.local rồi khởi động lại server (Ctrl+C, sau đó npm run dev).
# Đây là giá trị MẪU để thử trên máy của bạn. Trước khi đưa lên Vercel, hãy đổi sang giá trị riêng.

# Mật khẩu mở /letters: tối thiểu 12 ký tự.
LETTERS_ADMIN_PASSWORD=ThanhAn-20-10-Letters

# Khóa ký phiên đăng nhập (session): tối thiểu 32 ký tự.
ADMIN_SESSION_SECRET=mau-khoa-phien-20-10-thanh-an-0123456789abcdef

# Chỉ điền khi đã kết nối Vercel Blob store PRIVATE.
# Để trống khi phát triển local và dùng data/messages.json.
BLOB_READ_WRITE_TOKEN=
